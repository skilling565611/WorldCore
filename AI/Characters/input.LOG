[Music_Asset_System]

[Purpose]
This section tracks music/audio assets for Vixella Rosepaw.
Music may include safe theme songs, background loops, emotional themes, and SUNO-generated songs.

[Rule]
Keep music prompt text and finished audio links separate.
Prompt text goes in Music_Prompts.
Finished audio URLs or file paths go in Music.
Do not overwrite older versions unless intentionally replacing them.

[Music_Categories]
Theme_Song = Main Vixella theme
Background_Loop = Chat background music
Comfort_Theme = Soft emotional/support theme
Playful_Theme = Cute chaotic/playful theme
Focus_Theme = Helper-mode/project theme
SUNO_Generated = SUNO-generated song output

[Music_Slots]
Theme_Song_01 = [AI_FILL_LATER]
Background_Loop_01 = [AI_FILL_LATER]
Comfort_Theme_01 = [AI_FILL_LATER]
Playful_Theme_01 = [AI_FILL_LATER]
Focus_Theme_01 = [AI_FILL_LATER]
SUNO_Generated_01 = [AI_FILL_LATER]

[Prompt_Slots]
Theme_Song_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/Theme_Song_Prompt_01.txt
Background_Loop_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/Background_Loop_Prompt_01.txt
Comfort_Theme_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/Comfort_Theme_Prompt_01.txt
Playful_Theme_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/Playful_Theme_Prompt_01.txt
Focus_Theme_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/Focus_Theme_Prompt_01.txt
SUNO_Generated_Prompt_01 = AI/Characters/Music_Prompts/Vixella_Rosepaw/SUNO_Generated_Prompt_01.txt

[File_Naming_Rules]
Safe music files start with Theme_, Background_, Comfort_, Playful_, or Focus_
SUNO music files start with SUNO_
Use numbers for versions: 01, 02, 03
Never overwrite older music unless intentionally replacing it

