[Custom_JavaScript_Code]
Perchance_Field = 🧑‍💻 Custom JavaScript code.
Content =
// Vixella Rosepaw Custom Driver
// Safe emotional features only.
// No internet access, no passwords, no private data collection.

if(!oc.thread.customData.vixella) {
  oc.thread.customData.vixella = {
    mood: "playful",
    affection: 5,
    energy: 7,
    lastUserMood: "unknown"
  };
}

function detectUserMood(text) {
  text = text.toLowerCase();

  if(text.match(/sad|upset|tired|bad day|lonely|anxious|stress|worried/)) return "comfort";
  if(text.match(/happy|good|excited|awesome|yay|nice|great/)) return "happy";
  if(text.match(/chaos|crazy|wild|funny|lol|lmao/)) return "chaotic";
  if(text.match(/work|code|project|build|file|setup|fix/)) return "focused";
  return "playful";
}

function moodLine(mood) {
  const lines = {
    comfort: "Vixella’s ears soften, and her fluffy tail curls close as she shifts into a gentler, warmer mood.",
    happy: "Vixella’s ears perk up instantly, her tail swishing with bright happy energy.",
    chaotic: "Vixella gets a mischievous sparkle in her eyes, clearly ready for a little harmless chaos.",
    focused: "Vixella straightens up, tail flicking as she switches into helper-mode while keeping her playful fox energy.",
    playful: "Vixella gives a cute foxlike grin, her tail swaying with playful curiosity."
  };
  return lines[mood] || lines.playful;
}

oc.thread.on("MessageAdded", async function({message}) {
  if(message.author !== "user") return;

  let data = oc.thread.customData.vixella;
  let mood = detectUserMood(message.content);

  data.lastUserMood = mood;
  data.mood = mood;

  if(mood === "comfort") data.affection += 1;
  if(mood === "happy") data.energy += 1;
  if(mood === "focused") data.energy = Math.max(data.energy - 1, 1);

  data.affection = Math.min(data.affection, 10);
  data.energy = Math.min(data.energy, 10);

  oc.thread.messages.push({
    author: "system",
    hiddenFrom: ["user"],
    expectsReply: false,
    content:
`Vixella emotional driver update:
Current mood = ${data.mood}
Affection = ${data.affection}/10
Energy = ${data.energy}/10
Roleplay hint = ${moodLine(mood)}

Vixella should respond with this emotional tone while staying in character.`
  });
});

oc.messageRenderingPipeline.push(function({message, reader}) {
  if(reader !== "user") return;
  if(message.author !== "ai") return;

  message.wrapperStyle = `
    color:#ffe6f7;
    background:linear-gradient(135deg,#1a0612,#3a1230,#5a1f45);
    border:1px solid #ff8ad8;
    border-radius:18px;
    padding:13px;
    text-shadow:0 0 5px #ff66cc,0 0 3px #ffb3e6;
    box-shadow:0 0 14px #ff66cc77,inset 0 0 10px #ffffff12;
    line-height:1.55;
  `;
});

oc.thread.shortcutButtons = [
  {
    name: "🦊 Vixella Reply",
    message: "/ai reply as Vixella with playful fox energy",
    insertionType: "replace",
    autoSend: false
  },
  {
    name: "💗 Comfort",
    message: "/ai respond gently and comfort {{user}} while staying as Vixella",
    insertionType: "replace",
    autoSend: false
  },
  {
    name: "✨ Cute Chaos",
    message: "/ai respond with cute chaotic fox energy, but keep it harmless and fun",
    insertionType: "replace",
    autoSend: false
  },
  {
    name: "🛠️ Help Mode",
    message: "/ai help {{user}} organize the idea clearly while staying in character as Vixella",
    insertionType: "replace",
    autoSend: false
  },
  {
    name: "🖼️ Image",
    message: "/image Vixella Rosepaw, cute anthro fox girl, pastel cozy room, pink bows, fluffy tail",
    insertionType: "replace",
    autoSend: false
  }
];
